# Supabase — copy to .env.local and fill with your project's values
# Dashboard: Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...), safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only: required by QA, test-venue seed CLIs and isolated Playwright fixtures.
# Use the development project for tests. Never expose this key via
# a NEXT_PUBLIC_ variable or to browser code.
SUPABASE_SERVICE_ROLE_KEY=
# Server-only: 32 random bytes as 64 hex characters, shared privately by the founders.
# Required to decrypt E2E diagnostics downloaded from the public GitHub repository.
E2E_ARTIFACT_KEY=
# Optional paid profile-photo AI review. Keep disabled in local development
# unless actively testing the review flow.
PROFILE_PHOTO_REVIEW_ENABLED=false
# Server-only: required when PROFILE_PHOTO_REVIEW_ENABLED=true.
OPENAI_API_KEY=
# Optional override; defaults to gpt-5.5.
OPENAI_PHOTO_REVIEW_MODEL=

# Public origin used to build the venue check-in URL encoded in each QR code
# (admin dashboard). Defaults to window.location.origin when empty, so set it to
# the deployed URL (e.g. https://getamourette.com) before printing real QR codes.
NEXT_PUBLIC_SITE_URL=

# Resend stays off unless explicitly enabled in a production Vercel environment.
EMAIL_DELIVERY_ENABLED=false
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
RESEND_FROM_EMAIL="Amourette <hello@updates.getamourette.com>"
# Shared with Supabase Vault as `email_worker_secret`; Vault also stores the
# production `/api/email/process` URL as `email_worker_url` for pg_cron.
EMAIL_WORKER_SECRET=
